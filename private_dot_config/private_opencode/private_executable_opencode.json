{
 "$schema": "https://opencode.ai/config.json",
 "model": "ollama-cloud/deepseek-v4.1-flash:1017",
 "disabled_providers": [
  "cloudflare-ai-gateway"
 ],
 "providers": {
  "ollama-cloud": {
   "settings": {
    "baseURL": "https://ollama.com/v1"
   },
   "models": {
    "kimi-k3.1-pro": {
     "name": "Kimi K3.1 Pro (Ollama Cloud)",
     "limit": {
      "context": 1048576,
      "output": 131072
     },
     "capabilities": {
      "tools": true,
      "input": [
       "text",
       "image"
      ],
      "output": [
       "text"
      ],
      "reasoning": {
       "supported": true,
       "toggle": true
      }
     },
     "cost": {
      "input": 2,
      "output": 10,
      "cache_read": 0.2
     }
    }
   }
  }
 },
 "provider": {
  "openrouter": {
   "options": {
    "apiKey": "${OPENROUTER_API_KEY}"
   }
  },
  "google": {
   "options": {
    "apiKey": "${GOOGLE_API_KEY}"
   }
  }
 }
}